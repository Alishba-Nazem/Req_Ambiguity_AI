VITE_USE_MOCK=false
VITE_SITE_URL=https://your-domain.dev

# Local FastAPI (Vite proxies /api → http://localhost:8000):
# VITE_USE_MOCK=false

# Production on Vercel: keep VITE_USE_MOCK=false and set VITE_SITE_URL to the canonical HTTPS domain.
# Server-only secrets (Vercel Project → Settings → Environment Variables):
#   HF_TOKEN=hf_...          (required, never VITE_*)
#   HF_SPACE=lishyyyy-710/req-ambiguity-ai
